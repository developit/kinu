{
  "name": "ui-toolkit",
  "version": "1.0.0",
  "description": "Performance-focused Preact UI toolkit",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
